<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.Portal.Heading" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/portal_text_body</item>
    </style>

    <style name="TextAppearance.Portal.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/portal_text_body</item>
    </style>

    <style name="TextAppearance.Portal.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textColor">@color/portal_text_dim</item>
    </style>

    <style name="TextAppearance.Portal.SectionTitle" parent="TextAppearance.Portal.Heading">
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.Portal.ValueLarge" parent="TextAppearance.Portal.Heading">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/portal_primary</item>
    </style>

    <style name="TextAppearance.Portal.Url" parent="TextAppearance.Portal.Body">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/portal_primary</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>

    <style name="TextAppearance.Portal.Accent" parent="TextAppearance.Portal.Body">
        <item name="android:textColor">@color/portal_primary</item>
    </style>

    <style name="Widget.Portal.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:minHeight">@dimen/portal_touch_target_size</item>
        <item name="cornerRadius">26dp</item>
        <item name="backgroundTint">@color/portal_primary</item>
        <item name="android:textColor">@color/portal_text_on_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Widget.Portal.Button.Danger" parent="Widget.Portal.Button">
        <item name="backgroundTint">@color/portal_danger</item>
    </style>

    <style name="Widget.Portal.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/portal_switch_thumb</item>
        <item name="trackTint">@color/portal_switch_track</item>
        <item name="android:minHeight">@dimen/portal_touch_target_size</item>
        <item name="switchMinWidth">64dp</item>
    </style>

    <style name="TextAppearance.Portal.ActionBar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/portal_text_body</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="Widget.Portal.ActionBar" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="background">@color/portal_background</item>
        <item name="titleTextStyle">@style/TextAppearance.Portal.ActionBar.Title</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="ThemeOverlay.Portal.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/portal_primary</item>
        <item name="colorOnPrimary">@color/portal_text_on_primary</item>
        <item name="colorSurface">@color/portal_surface</item>
        <item name="colorOnSurface">@color/portal_text_body</item>
        <item name="android:background">@color/portal_surface</item>
        <item name="android:textColorPrimary">@color/portal_text_body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Portal.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Portal.Button.Text</item>
    </style>

    <style name="ThemeOverlay.Portal.SpinnerPopup" parent="ThemeOverlay.MaterialComponents">
        <item name="android:colorBackground">@color/portal_surface</item>
        <item name="android:textColorPrimary">@color/portal_text_body</item>
        <item name="colorSurface">@color/portal_surface</item>
        <item name="colorOnSurface">@color/portal_text_body</item>
    </style>

    <style name="Widget.Portal.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/portal_text_body</item>
        <item name="android:minHeight">@dimen/portal_touch_target_size</item>
    </style>

    <style name="Theme.Portal.Base" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/portal_primary</item>
        <item name="colorPrimaryVariant">@color/portal_surface</item>
        <item name="colorOnPrimary">@color/portal_text_on_primary</item>
        <item name="colorSecondary">@color/portal_primary</item>
        <item name="colorSecondaryVariant">@color/portal_surface</item>
        <item name="colorOnSecondary">@color/portal_text_on_primary</item>
        <item name="colorSurface">@color/portal_surface</item>
        <item name="colorOnSurface">@color/portal_text_body</item>
        <item name="android:colorBackground">@color/portal_background</item>
        <item name="colorOnBackground">@color/portal_text_body</item>
        <item name="android:textColorPrimary">@color/portal_text_body</item>
        <item name="android:textColorSecondary">@color/portal_text_dim</item>
        <item name="colorControlActivated">@color/portal_primary</item>
        <item name="colorControlNormal">@color/portal_text_dim</item>
        <item name="colorControlHighlight">@color/portal_primary</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:statusBarColor">@color/portal_background</item>
        <item name="android:navigationBarColor">@color/portal_background</item>
        <item name="android:windowBackground">@color/portal_background</item>
        <item name="materialButtonStyle">@style/Widget.Portal.Button</item>
        <item name="switchStyle">@style/Widget.Portal.Switch</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Portal.Dialog</item>
    </style>

    <style name="Theme.PortalPhotoFrame" parent="Theme.Portal.Base" />

    <style name="Theme.PortalPhotoFrame.Fullscreen" parent="Theme.PortalPhotoFrame">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.PortalPhotoFrame.Settings" parent="Theme.MaterialComponents">
        <item name="colorPrimary">@color/portal_primary</item>
        <item name="colorPrimaryVariant">@color/portal_surface</item>
        <item name="colorOnPrimary">@color/portal_text_on_primary</item>
        <item name="colorSecondary">@color/portal_primary</item>
        <item name="colorSecondaryVariant">@color/portal_surface</item>
        <item name="colorOnSecondary">@color/portal_text_on_primary</item>
        <item name="colorSurface">@color/portal_surface</item>
        <item name="colorOnSurface">@color/portal_text_body</item>
        <item name="android:colorBackground">@color/portal_background</item>
        <item name="colorOnBackground">@color/portal_text_body</item>
        <item name="android:textColorPrimary">@color/portal_text_body</item>
        <item name="android:textColorSecondary">@color/portal_text_dim</item>
        <item name="colorControlActivated">@color/portal_primary</item>
        <item name="colorControlNormal">@color/portal_text_body</item>
        <item name="colorControlHighlight">@color/portal_primary</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:statusBarColor">@color/portal_background</item>
        <item name="android:navigationBarColor">@color/portal_background</item>
        <item name="android:windowBackground">@color/portal_background</item>
        <item name="actionBarStyle">@style/Widget.Portal.ActionBar</item>
        <item name="materialButtonStyle">@style/Widget.Portal.Button</item>
        <item name="switchStyle">@style/Widget.Portal.Switch</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Portal.Dialog</item>
    </style>

</resources>
