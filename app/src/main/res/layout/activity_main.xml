<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/portal_background">

    <!-- Captures tap and horizontal swipes for controls / prev-next -->
    <FrameLayout
        android:id="@+id/photoTouchArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- Current slideshow image (full-bleed) -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="Slideshow image" />

    <!-- Crossfade second image -->
    <ImageView
        android:id="@+id/imageViewNext"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:alpha="0"
        android:contentDescription="Next slideshow image" />

    </FrameLayout>

    <!-- Empty state (offset below Portal system overlay) -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="@dimen/portal_system_overlay_padding"
        android:paddingStart="@dimen/portal_content_padding"
        android:paddingEnd="@dimen/portal_content_padding"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🖼️"
            android:textSize="64sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_images"
            android:textAppearance="@style/TextAppearance.Portal.Body"
            android:gravity="center"
            android:layout_marginTop="@dimen/portal_section_spacing" />

        <TextView
            android:id="@+id/serverUrlText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Portal.Accent"
            android:gravity="center"
            android:layout_marginTop="@dimen/portal_section_spacing" />
    </LinearLayout>

    <!-- Pause indicator -->
    <TextView
        android:id="@+id/pauseIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/portal_system_overlay_padding"
        android:background="@color/portal_scrim"
        android:paddingHorizontal="24dp"
        android:paddingVertical="@dimen/portal_item_spacing"
        android:text="@string/paused"
        android:textAppearance="@style/TextAppearance.Portal.Body"
        android:textColor="@color/portal_text_on_primary"
        android:visibility="gone" />

    <!-- Image counter -->
    <TextView
        android:id="@+id/imageCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/portal_content_padding"
        android:background="@color/portal_scrim"
        android:paddingHorizontal="12dp"
        android:paddingVertical="@dimen/portal_item_spacing"
        android:textAppearance="@style/TextAppearance.Portal.Caption"
        android:textColor="@color/portal_text_body"
        android:visibility="gone" />

    <!-- Overlay controls (shown on tap) -->
    <LinearLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/portal_scrim"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/portal_content_padding"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="@dimen/portal_touch_target_size"
            android:layout_height="@dimen/portal_touch_target_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:tint="@color/portal_text_on_primary"
            android:contentDescription="Previous"
            android:layout_marginEnd="@dimen/portal_section_spacing" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="@dimen/portal_touch_target_size"
            android:layout_height="@dimen/portal_touch_target_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_pause"
            android:tint="@color/portal_text_on_primary"
            android:contentDescription="Play/Pause"
            android:layout_marginEnd="@dimen/portal_section_spacing" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="@dimen/portal_touch_target_size"
            android:layout_height="@dimen/portal_touch_target_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            android:tint="@color/portal_text_on_primary"
            android:contentDescription="Next"
            android:layout_marginEnd="@dimen/portal_section_spacing" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="@dimen/portal_touch_target_size"
            android:layout_height="@dimen/portal_touch_target_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="@color/portal_text_on_primary"
            android:contentDescription="Settings"
            android:layout_marginEnd="@dimen/portal_section_spacing" />

        <TextView
            android:id="@+id/overlayIpText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Portal.Caption"
            android:textColor="@color/portal_primary" />
    </LinearLayout>

</FrameLayout>
