<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/portal_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/portal_content_padding"
        android:paddingEnd="@dimen/portal_content_padding"
        android:paddingBottom="@dimen/settings_card_gap"
        android:paddingTop="@dimen/portal_system_overlay_padding">

        <!-- Slideshow -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_card_background"
            android:padding="@dimen/settings_card_padding"
            android:layout_marginBottom="@dimen/settings_card_gap">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_slideshow"
                android:textAppearance="@style/TextAppearance.Portal.SectionTitle"
                android:layout_marginBottom="@dimen/portal_section_spacing" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/portal_item_spacing">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/slide_duration"
                    android:textAppearance="@style/TextAppearance.Portal.Body" />

                <TextView
                    android:id="@+id/durationValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Portal.ValueLarge" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/durationSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:min="0"
                android:max="11"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:progressTint="@color/portal_primary"
                android:thumbTint="@color/portal_primary"
                android:progressBackgroundTint="@color/portal_surface_elevated"
                android:layout_marginBottom="@dimen/portal_section_spacing" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_transition"
                android:textAppearance="@style/TextAppearance.Portal.Body"
                android:layout_marginBottom="@dimen/portal_item_spacing" />

            <Spinner
                android:id="@+id/transitionSpinner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/portal_touch_target_size"
                android:background="@color/portal_surface_elevated"
                android:popupTheme="@style/ThemeOverlay.Portal.SpinnerPopup"
                android:layout_marginBottom="@dimen/portal_section_spacing" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/portal_touch_target_size">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_shuffle"
                    android:textAppearance="@style/TextAppearance.Portal.Body" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/shuffleSwitch"
                    style="@style/Widget.Portal.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quiet hours -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_card_background"
            android:padding="@dimen/settings_card_padding"
            android:layout_marginBottom="@dimen/settings_card_gap">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_quiet_hours"
                android:textAppearance="@style/TextAppearance.Portal.SectionTitle"
                android:layout_marginBottom="@dimen/portal_item_spacing" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quiet_hours_summary"
                android:textAppearance="@style/TextAppearance.Portal.Caption"
                android:layout_marginBottom="@dimen/portal_section_spacing" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/portal_touch_target_size"
                android:layout_marginBottom="@dimen/portal_section_spacing">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/quiet_hours_enable"
                    android:textAppearance="@style/TextAppearance.Portal.Body" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/quietHoursSwitch"
                    style="@style/Widget.Portal.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quietHoursTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="@dimen/portal_item_spacing">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/portal_item_spacing">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quiet_from"
                        android:textAppearance="@style/TextAppearance.Portal.Caption"
                        android:layout_marginBottom="@dimen/portal_item_spacing" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuietStart"
                        style="@style/Widget.Portal.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/portal_item_spacing">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quiet_until"
                        android:textAppearance="@style/TextAppearance.Portal.Caption"
                        android:layout_marginBottom="@dimen/portal_item_spacing" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuietEnd"
                        style="@style/Widget.Portal.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/quietHoursNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quiet_hours_passive_note"
                android:textAppearance="@style/TextAppearance.Portal.Caption" />
        </LinearLayout>

        <!-- Web server -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_card_background"
            android:padding="@dimen/settings_card_padding"
            android:layout_marginBottom="@dimen/settings_card_gap">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_server"
                android:textAppearance="@style/TextAppearance.Portal.SectionTitle"
                android:layout_marginBottom="@dimen/portal_item_spacing" />

            <TextView
                android:id="@+id/serverInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Portal.Caption"
                android:layout_marginBottom="@dimen/portal_section_spacing" />

            <TextView
                android:id="@+id/serverUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_url_background"
                android:padding="@dimen/portal_content_padding"
                android:textAppearance="@style/TextAppearance.Portal.Url"
                android:textIsSelectable="true" />
        </LinearLayout>

        <!-- Storage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_card_background"
            android:padding="@dimen/settings_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_storage"
                android:textAppearance="@style/TextAppearance.Portal.SectionTitle"
                android:layout_marginBottom="@dimen/portal_item_spacing" />

            <TextView
                android:id="@+id/imageCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Portal.Body"
                android:layout_marginBottom="@dimen/portal_section_spacing" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteAll"
                style="@style/Widget.Portal.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete All Images" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
